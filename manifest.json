{
  "manifest_version": 3,
  "name": "Paper AI Assistant",
  "version": "1.1",
  "description": "논문 화면 드래그 캡처 및 Gemini AI 전문용어/Figure 직접 해설 도구",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}